{
  "layer": "top",
  "position": "bottom",
  "height": 0,
  "spacing": 0,
  "modules-left": [
    "custom/menu",
    "hyprland/workspaces",
    "group/system-controls",
    "wlr/taskbar"
  ],
  "modules-center": [
    "hyprland/window"
  ],
  "modules-right": [
    "group/hardware",
    "clock",
    "group/actions"
  ],
  "group/system-controls": {
    "orientation": "inherit",
    "modules": [
      "network",
      "backlight",
     //"backlight/slider",
      "wireplumber",
     //"pulseaudio/slider",
      "custom/tlp_profile",
      "bluetooth"
    ]
  },
  "group/hardware": {
    "orientation": "inherit",
    "modules": [
      "battery",
      "temperature",
      "cpu",
      "memory"
    ]
  },
  "group/actions": {
    "orientation": "inherit",
    "modules": [
      "tray",
      "custom/vpn",
      "custom/notification",
      "custom/power"
    ]
  },
  "custom/tlp_profile": {
    "format": "{}",
    "return-type": "json",
    "exec": "~/.config/waybar/scripts/tlp-profile-toggle.sh",
    "interval": "once",
    "signal": 8,
    "on-click": "~/.config/waybar/scripts/tlp-profile-toggle.sh set"
  },
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 16,
    "icon-theme": "Numix-Circle",
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "ignore-list": [
      "kitty"
    ],
    "app_ids-mapping": {
      "firefoxdeveloperedition": "firefox-developer-edition"
    },
    "rewrite": {
      "Firefox Web Browser": "Firefox"
    }
  },
  "custom/menu": {
    "format": " 󰣇 ",
    "on-click": "wofi -c ~/.config/wofi/menu-config",
    "tooltip": false
  },
  "hyprland/workspaces": {
    "on-scroll-up": "hyprctl dispatch workspace r-1",
    "on-scroll-down": "hyprctl dispatch workspace r+1",
    "on-click": "activate",
    "active-only": false,
    "all-outputs": true,
    "format": "{}",
    "format-icons": {
      "urgent": "",
      "active": "",
      "default": ""
    },
    "persistent-workspaces": {
      "*": 3
    }
  },
"clock": {
    "tooltip-format": "<big>  {:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format-alt": " {:%Y-%m-%d}",
    "format": " {:%H:%M}",
  },
  "hyprland/window": {
    "max-length": 60,
    "separate-outputs": true,
    "format": " <b>{}</b>"
  },
  "mpris": {
    "format": "{player_icon} <i>{title}</i>",
    "format-paused": "{status_icon} {title}",
    "max-length": 30,
    "player-icons": {
      "spotify": "",
      "firefox": "",
      "vlc": "",
      "default": "",
      "mpv": "🎵"
    },
    "status-icons": {
      "paused": "▶"
    }
  },
  "backlight/slider": {
    "min": 5,
    "max": 100,
    "orientation": "horizontal",
    "device": "intel_backlight"
  },
  "memory": {
    "interval": 5,
    "format": " {used:0.1f}GB",
    "format-alt": "󰍛 {avail}GB"
  },
  "cpu": {
    "interval": 1,
    "format": "{icon} {usage}%",
    "format-alt": "{icon0} {icon1} {icon2} {icon3} {icon4} {icon5} {icon6} {icon7} {usage}%",
    "format-icons": [
      "▁",
      "▂",
      "▃",
      "▄",
      "▅",
      "▆",
      "▇",
      "█"
    ]
  },
  "tray": {
    "icon-size": 20,
    "spacing": 8
  },
  "pulseaudio": {
    "format": "{icon} {volume}",
    "format-bluetooth": " {volume}",
    "format-bluetooth-muted": "󰝟 ",
    "tooltip": false,
    "format-muted": " ",
    "format-icons": {
      "default": [
        "󰝟 ",
        " ",
        "󰕾 ",
        " "
      ]
    },
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pavucontrol"
  },
  "pulseaudio/slider": {
    "min": 0,
    "max": 100,
    "orientation": "horizontal"
  },
  "custom/spotify": {
    "interval": 2,
    "exec": "~/.config/waybar/scripts/whatsong.sh",
    "exec-if": "pgrep spotify",
    "escape": true,
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },
  "custom/notification": {
    "escape": true,
    "exec": "swaync-client -swb",
    "exec-if": "which swaync-client",
    "format": "{icon}",
    "format-icons": {
      "dnd-inhibited-none": "󰂚<sup></sup>",
      "dnd-inhibited-notification": "󰂚<span foreground='#f38ba8'><sup></sup></span>",
      "dnd-none": "󰂛",
      "dnd-notification": "󰂛<span foreground='#f38ba8'><sup></sup></span>",
      "inhibited-none": "󰂚<sup>󰜺</sup>",
      "inhibited-notification": "󰵙<span foreground='#f38ba8'><sup></sup></span>",
      "none": "󰂚<span color='#6c7086'><sup></sup></span>",
      "notification": "󰂚<span foreground='#f38ba8'><sup></sup></span>"
    },
    "on-click": "sleep 0.1 && swaync-client -t -sw",
    "on-click-right": "sleep 0.1 && swaync-client -d -sw",
    "return-type": "json",
    "tooltip": false
  },
  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "wlogout --protocol layer-shell"
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "{icon} {percent}%",
        "format-icons": [
          "",
          "",
          "",
          "",
          "",
          "",
          "",
          "",
          ""
        ],
        "tooltip": false,
    "tooltip": false
  },
  "battery": {
    "interval": 10,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}% 󱔆{power:4.1f}W",
    "format-charging": "󰂄{capacity}% 󱟟{cycles} 󱔆{power:4.1f}W",
    "format-plugged": "󱘖 {capacity}% 󱔆{power:4.1f}W",
    "format-icons": [
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "format-alt": "󱧥 {time} 󱈑 {health}%",
    "on-click": "",
    "tooltip": false
  },
  "bluetooth": {
    "format": "",
    "format-disabled": "",
    "format-connected": "<span color='#b4befe'></span> {device_alias}",
    "tooltip-format": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}   {device_address}"
  },
  "network": {
    "format-wifi": "󰒢 {bandwidthTotalBits}",
    "format-alt": "󰒢 {essid}",
    "on-click-right": "nm-connection-editor",
    "format-ethernet": "󰈀 wired",
    "tooltip-format": "{essid} {signalStrength}%",
    "format-disconnected": "󰯡",
    "interval": 5
  },
  "temperature": {
    "thermal-zone": 3,
    "critical-threshold": 80,
    "format-critical": " {temperatureC}°C",
    "format": " {temperatureC}°C"
  },
  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-muted": "",
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "format-icons": [
      "",
      "",
      ""
    ],
    "scroll-step": 0.2
  },
  "disk": {
    "format": "  {free}/{total}"
  },
  "custom/vpn": {
    "format": "VPN ",
    "exec": "echo '{\"class\": \"connected\"}'",
    "exec-if": "test -d /proc/sys/net/ipv4/conf/tun0",
    "return-type": "json",
    "interval": 5
  }
}
